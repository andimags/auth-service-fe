# Base URL of this frontend app itself (client-exposed). Used by lib/api.ts's
# getBaseUrl() for constructing absolute URLs back to this app.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Present historically but currently unreferenced anywhere in the codebase
# (confirmed via full-repo grep). Kept here for parity with the real .env;
# safe to leave unset. See ENGINEERING_AUDIT.md.
NEXT_PUBLIC_AUTH_SERVICE_BASE_URL=

# NextAuth session encryption secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Canonical URL NextAuth uses for callbacks — should match where this app is served.
NEXTAUTH_URL=http://localhost:3000

# Backend (auth-service-be) base URL. Server-only (no NEXT_PUBLIC_ prefix) —
# never exposed to the browser. Used both by next.config.ts's /backend/* rewrite
# and directly by services/*.service.ts (see lib/api.ts for a note on that).
AUTH_SERVICE_BASE_URL=http://localhost:4000
